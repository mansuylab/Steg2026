        bam="results/01_preprocess/22_star_irfinder/{sample}_genome1_Aligned.sortedByCoord.out.bam",
        idx="results/01_preprocess/22_star_irfinder/{sample}_genome1_Aligned.sortedByCoord.out.bam.bai"
    log:
        star="logs/22_star_irfinder/{sample}_genome1_staralign.log"
    conda:
        "Steg2026/envs/star.yaml"
    threads: 8
    shell:
        """
        STAR \
            --runThreadN {threads} \
            --genomeDir {config[star_genome_dir]} \
            --sjdbGTFfile {config[GTF_file]} \
            --readFilesCommand zcat \
            --readFilesIn {input.R1} {input.R2} \
            --outFileNamePrefix results/01_preprocess/22_star_irfinder/{wildcards.sample}_genome1_ \
            --outSAMtype BAM SortedByCoordinate \
            --twopassMode Basic \
            --outSAMattributes NH HI AS NM MD \
            --outSAMstrandField intronMotif \
            --outFilterIntronMotifs RemoveNoncanonical \
            --alignIntronMin 20 \
            --alignIntronMax 1000000 \
            --alignMatesGapMax 1000000 \
            > {log.star} 2>&1

        # Generate index for the output BAM file
        samtools index {output.bam}
        """

