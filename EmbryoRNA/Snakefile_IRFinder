# Combine IRFinder results of all samples into matrices (IRratio, IntronDepth, SpliceExact)
rule irfinder_matrix:
    input:
        expand("results/01_preprocess/23_irfinder/{sample}_{genome}/IRFinder-IR-nondir.txt",
               sample=config["samples"],
               genome=["genome1", "genome2"])
    output:
        irratio="results/01_preprocess/23_irfinder/irfinder_matrix_IRratio.txt",
        intdepth="results/01_preprocess/23_irfinder/irfinder_matrix_IntronDepth.txt",
        spliceexact="results/01_preprocess/23_irfinder/irfinder_matrix_SpliceExact.txt"
    log:
        "logs/23_irfinder/irfinder_matrix.log"
    threads: 1
    run:
        import pandas as pd
        import os

        dfs_irratio = []
        dfs_intdepth = []
        dfs_spliceexact = []

        for f in input:
            sample = os.path.basename(os.path.dirname(f))
            df = pd.read_csv(f, sep="\t", usecols=["Chr", "Start", "End", "Name", "Strand",
                                                     "IRratio", "IntronDepth", "SpliceExact"])
            dfs_irratio.append(df[["Chr", "Start", "End", "Name", "Strand", "IRratio"]].rename(columns={"IRratio": sample}))
            dfs_intdepth.append(df[["Chr", "Start", "End", "Name", "Strand", "IntronDepth"]].rename(columns={"IntronDepth": sample}))
            dfs_spliceexact.append(df[["Chr", "Start", "End", "Name", "Strand", "SpliceExact"]].rename(columns={"SpliceExact": sample}))

        key_cols = ["Chr", "Start", "End", "Name", "Strand"]

        matrix_irratio = dfs_irratio[0]
        for df in dfs_irratio[1:]:
            matrix_irratio = matrix_irratio.merge(df, on=key_cols)

        matrix_intdepth = dfs_intdepth[0]
        for df in dfs_intdepth[1:]:
            matrix_intdepth = matrix_intdepth.merge(df, on=key_cols)

        matrix_spliceexact = dfs_spliceexact[0]
        for df in dfs_spliceexact[1:]:
            matrix_spliceexact = matrix_spliceexact.merge(df, on=key_cols)

        matrix_irratio.to_csv(output.irratio, sep="\t", index=False)
        matrix_intdepth.to_csv(output.intdepth, sep="\t", index=False)
        matrix_spliceexact.to_csv(output.spliceexact, sep="\t", index=False)

