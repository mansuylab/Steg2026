# Sort allele-specific BAM files and rename chromosomes to UCSC style (chr1, chrM) to match the BED12 annotation
rule sort_snpsplit_genome1:
    input:
        bam=config["snpsplit_dir"] + "/{sample}_trimmed_Aligned.out.genome1.bam"
    output:
        bam=temp("results/01_preprocess/24_genebody_coverage/{sample}_genome1.sorted.bam"),
        idx=temp("results/01_preprocess/24_genebody_coverage/{sample}_genome1.sorted.bam.bai")
    log:
        "logs/24_genebody_coverage/{sample}_genome1_sort.log"
    conda:
        "Steg2026/envs/samtools.yaml"
    threads: 4
    shell:
        """
        samtools sort -@ {threads} -m 2G \
            -o {output.bam}.tmp {input.bam} > {log} 2>&1

        samtools view -H {output.bam}.tmp | \
            sed 's/SN:\([0-9XYM]\)/SN:chr\\1/g' | \
            sed 's/SN:chrMT/SN:chrM/g' | \
            sed 's/SN:Un_/SN:chrUn_/g' | \
            samtools reheader - {output.bam}.tmp > {output.bam} 2>> {log}

        rm {output.bam}.tmp
        samtools index {output.bam} 2>> {log}
        """

