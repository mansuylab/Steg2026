rule star_irfinder_genome1:
    input:
        R1="results/01_preprocess/21_bam2fastq/{sample}_genome1_R1.fastq.gz",
        R2="results/01_preprocess/21_bam2fastq/{sample}_genome1_R2.fastq.gz"
