# Secondary workflow for intron retention and transcript integrity analyses in two-cell embryos.
# Requires the SNPsplit output of the main EmbryoRNA workflow (Snakefile).
# Paternal (genome1) and maternal (genome2) reads are converted back to FASTQ, realigned with STAR (two-pass)
# for IRFinder-S, and TIN scores are calculated on the allele-specific BAM files.

configfile: "config_IRFinder.yaml"

input_files = expand(
    [
    "results/01_preprocess/23_irfinder/{sample}_genome1/IRFinder-IR-nondir.txt",
    "results/01_preprocess/23_irfinder/{sample}_genome2/IRFinder-IR-nondir.txt",
    "results/01_preprocess/24_genebody_coverage/{sample}_genome1.tin.tsv",
    "results/01_preprocess/24_genebody_coverage/{sample}_genome2.tin.tsv"
