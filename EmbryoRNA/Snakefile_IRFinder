    sample=config["samples"]
) + [
    "results/01_preprocess/23_irfinder/irfinder_matrix_IRratio.txt",
    "results/01_preprocess/23_irfinder/irfinder_matrix_IntronDepth.txt",
    "results/01_preprocess/23_irfinder/irfinder_matrix_SpliceExact.txt",
    "results/02_qc_plots/17_star_irfinder/multiqc_report.html",
    "results/01_preprocess/24_genebody_coverage/merged_genome1.tin.tsv",
    "results/01_preprocess/24_genebody_coverage/merged_genome2.tin.tsv"
