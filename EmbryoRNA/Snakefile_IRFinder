        R2=temp("results/01_preprocess/21_bam2fastq/{sample}_genome1_R2.fastq.gz")
    log:
        "logs/21_bam2fastq/{sample}_genome1.log"
    conda:
        "Steg2026/envs/samtools.yaml"
    threads: 4
    shell:
        """
        samtools collate -@ {threads} -u -O {input.bam} \
            | samtools fastq -@ {threads} \
                -1 {output.R1} \
                -2 {output.R2} \
                -0 /dev/null -s /dev/null \
